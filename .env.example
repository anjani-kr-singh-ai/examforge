# ---- LLM provider ----
# anthropic | openai | bedrock | mock
#   mock    = offline deterministic stand-in. Output is clearly labelled MOCK and is NOT real model output.
#   openai  = any OpenAI-compatible endpoint (OpenAI, Gemini, Groq, Ollama...) via LLM_BASE_URL
#   bedrock = AWS Bedrock Converse (e.g. zai.glm-5, qwen.qwen3-235b-a22b-2507-v1:0); auth via AWS_PROFILE
#             (SSO: run `aws sso login --profile <name>` first). No key stored here.
# AWS_PROFILE=
# AWS_DEFAULT_REGION=ap-south-1
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Anthropic SDK reads ANTHROPIC_API_KEY itself; for the openai provider set LLM_API_KEY
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
# low | medium | high | xhigh | max  (Claude effort; ignored by other providers)
LLM_EFFORT=high
LLM_MAX_TOKENS=16000

# Optional: use a different model for the reviewer agents to reduce correlated errors
REVIEWER_PROVIDER=
REVIEWER_MODEL=

# ---- Retrieval ----
CHUNK_SIZE=350
CHUNK_OVERLAP=60
TOP_K=6
MIN_RELEVANCE=0.25

# ---- Reliability ----
MAX_RETRIES=3
MAX_REVISIONS=1
DUPLICATE_THRESHOLD=0.92
SIMILAR_THRESHOLD=0.82

# Prompt versions per stage, e.g. question_setter=v2,critical_examiner=v1
PROMPT_VERSIONS=
